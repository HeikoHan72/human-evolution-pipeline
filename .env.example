# Copy to .env and fill in. .env is ignored by git.

# Folder with Datensätze/, Ausgabe/ and Zwischen/ (default: <repo>/data)
# GENOM_BASIS=/path/to/data

# PostgreSQL (script 12)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# MongoDB (script 13)
MONGO_URI=mongodb://localhost:27017

# Neo4j (script 14)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Rebuild the databases from scratch (scripts 12 to 14); the Airflow DAG sets this itself
# GENOM_NEU_AUFBAUEN=1
